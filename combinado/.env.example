# Variáveis do site e do painel.
# No computador: copie para .env.local. Na hospedagem (Vercel, Netlify, Cloudflare): cadastre nas configurações do projeto.
# Sem VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY, o painel abre no modo demonstração.

# Supabase → Project Settings → API Keys (use a chave pública anon/publishable, nunca a service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final (tags de compartilhamento). Ex.: https://seudominio.com.br
VITE_SITE_URL=

# Opcional: botão "Conectar com a Meta" (cadastro incorporado do WhatsApp). Veja o DEPLOY.md, etapa 6.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=

# Opcional: botões de login social na tela de acesso (google, microsoft; apple é opcional). "nenhum" esconde todos.
VITE_AUTH_PROVIDERS=google,microsoft

# Proteção contra robôs (opcional): chave pública do Cloudflare Turnstile. A chave secreta vai no Supabase
# (Authentication → Attack Protection → Captcha). Sem ela, o cadastro usa só o campo-armadilha e o tempo mínimo.
VITE_TURNSTILE_SITE_KEY=
