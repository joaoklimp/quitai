# Segredos das Edge Functions. Copie para supabase/functions/.env, preencha e envie:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem nas funções publicadas: não defina aqui.
# Explicação de cada variável: DEPLOY.md, etapa 2.

# IA (Anthropic). AI_MODEL vale para os comandos da equipe; AI_MODEL_CUSTOMER, para as respostas aos clientes.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODEL_CUSTOMER=claude-sonnet-5-5

# WhatsApp (Meta). META_VERIFY_TOKEN é uma senha que você inventa e repete no app da Meta.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Pagamentos (Asaas). ASAAS_ENV: sandbox para testar, production para cobrar de verdade.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Agendador: o mesmo valor guardado no Vault como cron_secret (DEPLOY.md, etapa 1)
CRON_SECRET=

# Chave que criptografa os tokens do WhatsApp e as chaves de API das clínicas guardados no banco (AES-256-GCM).
# 64 caracteres hexadecimais (ex.: openssl rand -hex 32). Não troque depois de usar: os segredos gravados deixariam de abrir.
DATA_ENCRYPTION_KEY=

# Endereço do site, sem barra no final, e origens que podem chamar as funções (separadas por vírgula)
SITE_URL=https://seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Espera (ms) por mais mensagens seguidas do cliente antes de responder tudo junto
WA_DEBOUNCE_MS=2500

# Transcrição dos áudios do WhatsApp (opcional, recomendado). Padrão: Groq (Whisper). Sem chave, a IA pede para escrever.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
